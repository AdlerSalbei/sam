model AppTag {
  id   String         @id @default(cuid(2))
  name String         @unique
  apps ExternalApps[]
}

model ExternalApps {
  id          String   @id @default(cuid(2))
  name        String
  slug        String   @unique
  description String
  icon        String?
  imageSrc    String?
  tags        AppTag[]
  url         String   @unique
  team        String[]
}
